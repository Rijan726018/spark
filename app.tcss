/* ═══════════════════════════════════════════════════════════════
   ALGO TERMINAL  —  Bloomberg Dark Theme
═══════════════════════════════════════════════════════════════ */

Screen {
    background: #000000;
    color: #ccaa00;
}

/* ── Header / Footer ─────────────────────────────────────────── */
Header {
    background: #0a0800;
    color: #ffcc00;
    border-bottom: solid #332200;
    text-style: bold;
}

Footer {
    background: #080600;
    color: #665500;
    border-top: solid #221500;
}

/* ── Body ────────────────────────────────────────────────────── */
#body {
    height: 1fr;
}

/* ── Sidebar ─────────────────────────────────────────────────── */
#sidebar {
    width: 32;
    background: #050400;
    border-right: solid #2a1a00;
}

#sidebar-title {
    height: 3;
    background: #0d0900;
    color: #ffcc00;
    text-style: bold;
    content-align: left middle;
    border-bottom: solid #2a1a00;
    padding: 0 1;
}

ListView {
    background: #050400;
    border: none;
    padding: 0;
}

ListView > ListItem {
    background: #050400;
    color: #888888;
    padding: 0 1;
    border-bottom: solid #111111;
    height: 3;
}

ListView > ListItem.--highlight {
    background: #111111;
    color: #ffffff;
    border-left: solid #007aff;
    text-style: bold;
}

ListView:focus > ListItem.--highlight {
    background: #1a1000;
    color: #ffdd00;
    border-left: solid #ffcc00;
}

/* ── Main panel ──────────────────────────────────────────────── */
#main-panel {
    background: #000000;
    padding: 0;
}

#algo-header {
    height: 3;
    background: #0a0800;
    color: #ffdd00;
    text-style: bold;
    content-align: left middle;
    border-bottom: solid #2a1a00;
    padding: 0 2;
}

#algo-desc {
    height: 2;
    color: #555500;
    padding: 0 2;
    border-bottom: solid #110900;
}

/* ── Stats grid ──────────────────────────────────────────────── */
#stats-grid {
    layout: grid;
    grid-size: 3 2;
    grid-gutter: 1;
    height: 14;
    padding: 1 1 0 1;
}

StatBox {
    background: #080600;
    border: solid #221500;
    align: center middle;
    padding: 0 1;
    height: 6;
}

StatBox:hover {
    border: solid #443300;
}

.stat-label {
    color: #554400;
    text-align: center;
    width: 100%;
    text-style: none;
}

.stat-value {
    color: #ffb300;
    text-style: bold;
    text-align: center;
    width: 100%;
}

/* ── Action bar ──────────────────────────────────────────────── */
#action-bar {
    height: 5;
    padding: 1 1;
    border-top: solid #110900;
    border-bottom: solid #110900;
    align: left middle;
}

Button {
    background: #0d0900;
    color: #ccaa00;
    border: solid #332200;
    margin: 0 1;
    min-width: 18;
    text-style: bold;
}

Button:hover {
    background: #1a1100;
    border: solid #ffaa00;
    color: #ffdd00;
}

Button:focus {
    background: #1a1100;
    border: solid #ffcc00;
    color: #ffee00;
}

Button.-primary {
    background: #150d00;
    border: solid #cc8800;
    color: #ffcc00;
}

Button.-primary:hover {
    background: #1e1400;
    border: solid #ffcc00;
    color: #ffee00;
}

Button:disabled {
    background: #080600;
    color: #2a2000;
    border: solid #110900;
}

#status-msg {
    padding: 0 2;
    color: #887700;
    content-align: left middle;
    height: 3;
}

/* ── Trade log ───────────────────────────────────────────────── */
#log-title {
    height: 2;
    background: #0a0800;
    color: #ffcc00;
    text-style: bold;
    content-align: left middle;
    border-bottom: solid #2a1a00;
    border-top: solid #2a1a00;
    padding: 0 2;
}

DataTable {
    background: #030200;
    color: #887700;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #0d0900;
    color: #ffb300;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1a1000;
    color: #ffee00;
}

DataTable > .datatable--hover {
    background: #100c00;
}

DataTable > .datatable--header-cursor {
    background: #221500;
    color: #ffee00;
}
