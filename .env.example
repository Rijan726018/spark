# ── Tradovate credentials (required for live trading) ─────────────────────────
TV_USERNAME=
TV_PASSWORD=
TV_APP_ID=
TV_APP_VERSION=1.0
TV_CID=
TV_SEC=

# ── Tradovate API endpoints ────────────────────────────────────────────────────
TRADOVATE_API_URL=https://demo.tradovateapi.com/v1
TRADOVATE_AUTH_URL=https://demo.tradovateapi.com/v1/auth/accesstokenrequest
TRADOVATE_MD_WS_URL=wss://md.tradovateapi.com/v1/websocket

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ── FastAPI server ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed origins for CORS (use specific origins in production)
CORS_ORIGINS=http://localhost:3000,app://nexus

# ── NinjaTrader execution (optional) ──────────────────────────────────────────
CROSSTRADE_SECRET_KEY=

# ── Celery ─────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Market data ────────────────────────────────────────────────────────────────
ES_SYMBOL=ESM4

# ── Trend Engine / Spark content app ──────────────────────────────────────────
# YouTube Data API v3 key (free): https://console.cloud.google.com
#   -> create project -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=
# Optional LLM for sharper hooks/titles. Set ONE of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides
# TREND_LLM_MODEL=claude-sonnet-4-5
# TREND_GEO=US
# TREND_YOUTUBE_DAYS=7

# ── Spark billing (Stripe) ─────────────────────────────────────────────────────
# Leave empty for DEV MODE (everything unlocked, simulated checkout).
# To take real payments: dashboard.stripe.com -> API keys + a $9/mo Price,
# and a webhook endpoint pointing at /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Spark token email (Resend or SMTP) ────────────────────────────────────────
# Emails the Pro access token on checkout + powers /api/token/recover.
# Set ONE provider. Leave both empty to skip sending (dev mode; token still
# reaches the app via the checkout redirect, and stays in spark_users.db).
# Resend (resend.com, free tier): just the API key.
RESEND_API_KEY=
# ...or plain SMTP (STARTTLS):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender + the URL printed inside the email:
SPARK_EMAIL_FROM=Spark <onboarding@resend.dev>
SPARK_PUBLIC_URL=https://sparkbrief.fly.dev
